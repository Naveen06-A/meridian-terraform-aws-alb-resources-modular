aws_region = "ap-south-1"

albs = {
  application_alb = {
    name               = "REPLACE_WITH_ALB_NAME"
    internal           = false
    load_balancer_type = "application"

    security_groups = [
      "REPLACE_WITH_SECURITY_GROUP_ID"
    ]

    subnets = [
      "REPLACE_WITH_SUBNET_ID_1",
      "REPLACE_WITH_SUBNET_ID_2"
    ]

    enable_deletion_protection = true
    drop_invalid_header_fields = true
    idle_timeout               = 60

    tags = {
      Environment = "REPLACE_WITH_ENVIRONMENT"
      ManagedBy   = "Terraform"
    }
  }
}
