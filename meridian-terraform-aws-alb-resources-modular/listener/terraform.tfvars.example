aws_region = "ap-south-1"

listeners = {
  http = {
    load_balancer_arn = "REPLACE_WITH_EXISTING_ALB_ARN"

    port     = 80
    protocol = "HTTP"

    default_action_type         = "fixed-response"
    fixed_response_content_type = "text/plain"
    fixed_response_message_body = "No matching rule"
    fixed_response_status_code  = "404"

    tags = {
      Environment = "REPLACE_WITH_ENVIRONMENT"
      ManagedBy   = "Terraform"
    }
  }
}
