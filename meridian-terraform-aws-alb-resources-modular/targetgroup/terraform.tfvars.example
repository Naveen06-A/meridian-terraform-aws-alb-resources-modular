aws_region = "ap-south-1"

target_group_config = [
  {
    name        = "REPLACE_WITH_TG_NAME"
    port        = 80
    protocol    = "HTTP"
    vpc_id      = "REPLACE_WITH_VPC_ID"
    target_type = "instance"

    health_check = {
      enabled             = true
      protocol            = "HTTP"
      port                = "traffic-port"
      path                = "/"
      matcher             = "200-399"
      interval            = 30
      timeout             = 5
      healthy_threshold   = 3
      unhealthy_threshold = 3
    }

    tags = {
      Environment = "REPLACE_WITH_ENVIRONMENT"
      ManagedBy   = "Terraform"
    }
  }
]
